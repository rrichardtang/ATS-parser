.venv/
__pycache__/
*.pyc
.pytest_cache/
tests/fixtures/*.pdf
runs/
corpus/resumes/rendered/
corpus/resumes/real/
node_modules/

# AI agent config: allowlist what's meant to be shared, ignore the rest
# (personal overrides like .claude/settings.local.json stay out of git; the push-gate
# receipt lives in .git/ and never touches the working tree)
.claude/*
!.claude/settings.json
!.claude/agent-notes/
!.claude/vendor/
